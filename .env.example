# Copy to .env and fill real values. Never commit .env.

# Telegram alerts
# 1) @BotFather → /newbot → token
# 2) Message your bot /start, then getUpdates → chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Protect /api/scan (Vercel Cron uses Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me-long-random

# Live scan candle interval (default 1h)
SIGNAL_TIMEFRAME=1h
