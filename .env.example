# Copy to .env and fill real values. Never commit .env.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRON_SECRET=change-me-long-random

# Telegram / scan timeframes (default 5m,15m,1h)
SIGNAL_TIMEFRAMES=5m,15m,1h
SIGNAL_RECENT_HOURS=24
SIGNAL_FRESH_MINUTES=18

# Optional fixed watchlist override (else desk watchlist / defaults)
# SIGNAL_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XAUTUSDT

# GitHub Actions secrets: SCAN_URL + CRON_SECRET
