    "risk": {
      "allow_long": true,
      "allow_short": true,
      "max_positions_per_symbol_timeframe": 1,
      "risk_pct": 0.005,
      "initial_equity": 10000.0,
      "leverage": 1.0
    },
    "costs": {
      "fee_per_side": 0.0005,
      "slippage_per_side": 0.0002,
